{
  "$schema": "https://opencode.ai/config.json",
  "plugins": ["ecc-universal"],
  "mcp": {
    "servers": {
      "better-auth": {
        "type": "remote",
        "url": "https://mcp.inkeep.com/better-auth/mcp"
      },
      "cloudflare-api": {
        "type": "remote",
        "url": "https://mcp.cloudflare.com/mcp"
      },
      "figma": {
        "type": "remote",
        "url": "https://mcp.figma.com/mcp"
      },
      "firefox devtools": {
        "type": "local",
        "command": ["npx", "@padenot/firefox-devtools-mcp", "mcp"]
      },
      "shadcn": {
        "type": "local",
        "command": ["npx", "shadcn@latest", "mcp"]
      },
      "supabase": {
        "type": "remote",
        "url": "https://mcp.supabase.com/mcp"
      }
    }
  },
  "snapshots": false
}
