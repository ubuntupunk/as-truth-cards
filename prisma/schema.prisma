// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Trope Cards
model Card {
  id                       Int               @id @default(autoincrement())
  createdAt                DateTime          @default(now()) @map("created_at")
  title                    String
  frontDescription         String            @map("front_description")
  backDescription          String            @map("back_description")
  symbol                   String
  imageUrl                 String?           @map("image_url")
  tags                     String[]
  includedInPalestineStack Boolean           @default(false) @map("included_in_palestine_stack")
  isFeatured               Boolean           @default(false) @map("is_featured")
  sources                  Json?
  interactions             UserInteraction[]

  @@map("cards")
}

// Authorization ladder. Better Auth owns identity and sessions; this enum is
// ours, stored on the user row. The database rejects unknown roles.
enum UserRole {
  ANONYMOUS   // Basic view access only
  VERIFIED    // Email verified users - limited interaction
  ACADEMIC    // Academic institutions
  RESEARCHER  // Verified researchers
  MODERATOR   // Can moderate comments
  ADMIN       // Full access
}

// Better Auth core models. Shape generated by
// `npx @better-auth/cli generate --config server/auth.ts`, with `role` bound to
// the existing UserRole enum and the former UserProfile columns folded in.
model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  role          UserRole  @default(ANONYMOUS)
  bio           String?
  website       String?
  location      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  interactions  UserInteraction[]
  drafts        DecompositionDraft[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// User Interactions with Cards
model UserInteraction {
  id              Int             @id @default(autoincrement())
  createdAt       DateTime        @default(now()) @map("created_at")
  userId          String?         @map("user_id")
  cardId          Int             @map("card_id")
  interactionType InteractionType
  feedbackRating  Int?
  feedbackText    String?
  status          ContentStatus   @default(PENDING)
  ipAddress       String?
  card            Card            @relation(fields: [cardId], references: [id])
  user            User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId, interactionType])
  @@map("user_interactions")
}

enum ContentStatus {
  PENDING
  APPROVED
  FLAGGED
  REJECTED
  REMOVED
}

enum InteractionType {
  VIEW
  SHARE
  RATING_UP
  RATING_DOWN
  STRUCTURED_FEEDBACK
  ACADEMIC_FEEDBACK
  MODERATION_ACTION
}

// User-authored claim decomposition and argument-chain work, from the
// Compose/Decompose surface. This is participation data, not ontology data: the
// canonical graph lives in the `trope_graph` schema and is never written here.
// A draft references graph entities by slug/uuid string with no foreign key,
// because `trope_graph` is a separate schema the projection owns; the column is
// deliberately *not* named `cards` so it can never be mistaken for a canonical
// card row.
model DecompositionDraft {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  cardSlug  String   @map("card_slug")
  // The validated draft payload (steps + chains). Shape is enforced at the API
  // boundary by `server/composition/draft-contract.ts`; the free `Json` column
  // stores it verbatim so a schema change never silently rewrites authored work.
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cardSlug])
  @@index([userId])
  @@map("decomposition_drafts")
}
