# Database (Neon Postgres)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Better Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# The public origin the browser uses. In development that is the Vite dev server on
# :8080, not the Express server on :3001, because Vite proxies /api through to it.
# In production Express serves both, so this is your deployed site URL.
BETTER_AUTH_URL="http://localhost:8080"

# Email (Resend)
RESEND_API_KEY=""
RESEND_FROM="Trope Deck <noreply@tropecards.com>"

# Research-source discovery (admin-only /api/discovery)
# Each provider asks to be identified by a contact address. Both are optional: discovery works
# without them, but the provider cannot place the client in its polite pool.
CROSSREF_MAILTO=""
DATACITE_MAILTO=""
