# Database (Neon Postgres)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Better Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# The public origin the browser uses. In development that is the Vite dev server on
# :8080, not the Express server on :3001, because Vite proxies /api through to it.
# In production Express serves both, so this is your deployed site URL.
BETTER_AUTH_URL="http://localhost:8080"
