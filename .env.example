# Database (Neon Postgres)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Owner/migration credentials (optional, recommended in production).
#
# DATABASE_URL above is the *runtime* credential. If it points at a non-owner role, set the
# owner URL here so `db:migrate:deploy` (Prisma) and `trope-graph:migrate` can still issue DDL.
# The discovery-event privilege boundary depends on this split — see README, "Separating
# migration and runtime database roles". Leave unset locally to keep one connection.
DATABASE_MIGRATION_URL=""
# Graph-specific owner URL; falls back to DATABASE_MIGRATION_URL, then DATABASE_URL.
TROPE_GRAPH_MIGRATION_URL=""

# Better Auth
# Generate with: openssl rand -base64 32
#
# One secret per environment — never reuse another environment's value. Better Auth signs
# verification, email-change and password-reset tokens as stateless JWTs with this secret,
# so a token is valid only where it was signed: a shared secret lets a leaked development
# value mint links production will accept, and rotating it signs out every environment.
BETTER_AUTH_SECRET=""
# The public origin the browser uses. In development that is the Vite dev server on
# :8080, not the Express server on :3001, because Vite proxies /api through to it.
# In production Express serves both, so this is your deployed site URL.
#
# Links are environment-scoped, so this must name the environment that will validate them:
# a dev server pointed at the deployed origin mails links that host will reject. Production
# refuses to start if this is missing, malformed, loopback, or not https.
BETTER_AUTH_URL="http://localhost:8080"

# Email (Resend)
# Sending domain: medialternatives.com, verified in Resend (DKIM + SPF, sending enabled).
# Use a From address on a domain Resend has verified. An unverified domain is rejected, and
# because email is best-effort the auth endpoints still answer success — the only symptom is
# an `email.provider_rejected` log line. `tropecards.com` is not registered, so never use it.
#
# Auth mail is sent with click tracking off: tracking rewrites links through links.<domain>,
# and a scanner that prefetches the URL can consume a single-use verification token. Every
# message also carries the sponsor signature defined in server/lib/email-signature.ts.
RESEND_API_KEY=""
RESEND_FROM="Trope Deck <tropes@medialternatives.com>"

# Research-source discovery (admin-only /api/discovery)
# Each provider asks to be identified by a contact address. Both are optional: discovery works
# without them, but the provider cannot place the client in its polite pool.
CROSSREF_MAILTO=""
DATACITE_MAILTO=""
